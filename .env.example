# Postgres connection string from Neon (or any Postgres host)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# GitHub personal access token — needs public_repo read scope for code search
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random string you make up — protects the crawl route from random triggers
CRON_SECRET=change-this-to-something-random

# Comma-separated list of GitHub owners whose skills auto-publish without review
TRUSTED_OWNERS=anthropics

# Repos with at least this many stars auto-publish if the safety scan is clean
AUTO_PUBLISH_STAR_THRESHOLD=500

# Password for the internal /admin/review page (not full auth — just a shared secret)
ADMIN_PASSWORD=change-this-too

# Public API base URL, used by the CLI package once deployed
SKILLFORGE_API_URL=https://your-deployed-site.vercel.app/api
